{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "server/harness-entry.ts",
    "server/solana/solana-service.ts",
    "server/solana/solana-routed-tools.ts",
    "server/solana/local-wallets.ts",
    "shared/product.ts"
  ],
  "exclude": ["**/*.test.ts"]
}
